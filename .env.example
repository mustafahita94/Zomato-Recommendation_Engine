# Copy this file to .env and fill in real values.
# Never commit .env.
# Frontend API URL lives in web/.env.local (see web/.env.local.example).

# Groq (OpenAI-compatible API)
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional tuning
LLM_TEMPERATURE=0.3
LLM_MAX_RECOMMENDATIONS=5
CANDIDATE_LIMIT=20

# CORS — comma-separated frontend origins (localhost:3000 always included).
# After Vercel deploy, add your production URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
# Optional: allow all Vercel preview URLs
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
